# for use -> cp .env.example .env
# change values with your editor e.g. vim .env

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phisheye

# pgadmin
PGADMIN_DEFAULT_EMAIL=team@teamphive.de
PGADMIN_DEFAULT_PASSWORD=change-me

# keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# public address of the frontend, allowed as login redirect in keycloak
FRONTEND_URL=http://localhost:5173
# address the browser uses for keycloak, without trailing slash. The backend
# expects it as issuer of the tokens, the frontend logs in there.
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# minio
MINIO_ROOT_USER=phisheye
MINIO_ROOT_PASSWORD=change-me

# app (docker compose --profile app up -d --build)
FRONTEND_PORT=5173

SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USERNAME=report@phishing.neumanns.nrw
SMTP_PASSWORD=
