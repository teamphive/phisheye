# for use -> cp .env.example .env
# change values with your editor e.g. vim .env

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phisheye

# pgadmin
PGADMIN_DEFAULT_EMAIL=team@teamphive.de
PGADMIN_DEFAULT_PASSWORD=change-me

# keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# minio
MINIO_ROOT_USER=phisheye
MINIO_ROOT_PASSWORD=change-me

# app (docker compose --profile app up -d --build)
FRONTEND_PORT=8081
# public URLs, baked into the frontend at build time, empty = no login
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=phisheye
VITE_KEYCLOAK_CLIENT_ID=phisheye-frontend
