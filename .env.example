# for use -> cp .env.example .env
# change values with your editor e.g. vim .env
# one file for everything: local `just dev` and docker compose both read it
# create secrets with `openssl rand -base64 24` 

# postgres
POSTGRES_USER=phisheye
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phisheye
# only used outside docker, compose sets its own host for the containers
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgadmin
PGADMIN_DEFAULT_EMAIL=team@teamphive.de
PGADMIN_DEFAULT_PASSWORD=change-me

# keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# only used outside docker, compose sets its own host for the containers
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=phisheye
KEYCLOAK_AUDIENCE=phisheye-backend
# service account of the backend, creates the accounts of invited people.
# The secret goes into the realm at its first import.
KEYCLOAK_SERVICE_CLIENT_ID=phisheye-backend-admin
KEYCLOAK_SERVICE_CLIENT_SECRET=change-me
# public address of the frontend, allowed as login redirect in keycloak
FRONTEND_URL=http://localhost:5173
# address the browser uses for keycloak, without trailing slash. The backend
# expects it as issuer of the tokens, the frontend logs in there.
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# minio / s3
MINIO_ROOT_USER=phisheye
MINIO_ROOT_PASSWORD=change-me
# only used outside docker, compose sets its own host for the containers
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=phisheye
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=phisheye-eml
S3_REGION=us-east-1

# address the metrics ports listen on. Locally 127.0.0.1, on the server the LAN
# address of the VM, reachable for Prometheus (firewall: only its host)
METRICS_BIND=127.0.0.1
# read only user of the postgres exporter, see deployment/monitoring/README.md
POSTGRES_MONITOR_PASSWORD=change-me

# app (docker compose --profile app up -d --build)
FRONTEND_PORT=5173
# comma separated, only for the Vite dev server
CORS_ORIGINS=http://localhost:5173

VT_API_KEY=
MAILGUN_WEBHOOK_SIGNING_KEY=
PHISHEYE_DEFAULT_TEAM_ID=
PHISHEYE_SYSTEM_USER_ID=

POP3_HOST=pop3.strato.de
POP3_PORT=995
POP3_USERNAME=report@phishing.neumanns.nrw
POP3_PASSWORD=

SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USERNAME=report@phishing.neumanns.nrw
SMTP_PASSWORD=

# only used outside docker, compose sets its own host for the containers
REDIS_URL=redis://localhost:6379/0
