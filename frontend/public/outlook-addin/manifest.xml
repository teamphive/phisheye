<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>23bc0efc-406c-4117-95a5-b8f4b4f41fa8</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>teamphive</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="phisheye Melden"/>
  <Description DefaultValue="Meldet die geöffnete Mail als Phishing an phisheye."/>
  <IconUrl DefaultValue="https://phisheye.neumann-it.org/outlook-addin/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://phisheye.neumann-it.org/outlook-addin/icon-128.png"/>
  <SupportUrl DefaultValue="https://phisheye.neumann-it.org"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://phisheye.neumann-it.org/outlook-addin/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="phisheye.group">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="phisheye.report">
                  <Label resid="Report.Label"/>
                  <Supertip>
                    <Title resid="Report.Label"/>
                    <Description resid="Report.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>report</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://phisheye.neumann-it.org/outlook-addin/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://phisheye.neumann-it.org/outlook-addin/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://phisheye.neumann-it.org/outlook-addin/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://phisheye.neumann-it.org/outlook-addin/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="phisheye"/>
        <bt:String id="Report.Label" DefaultValue="Melden"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Report.Tip" DefaultValue="Meldet diese Mail als Phishing. Es öffnet sich eine neue Mail mit der Meldung als Anhang, du musst nur noch auf Senden klicken."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
