# for use -> cp .env.example .env
# These values are public: the browser client has no secret, PKCE protects the flow.
# Without them the app starts without a login, which keeps the interface usable
# while Keycloak is not running.

VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=phisheye
VITE_KEYCLOAK_CLIENT_ID=phisheye-frontend

VITE_API_URL=http://localhost:8000
