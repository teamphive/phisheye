set shell := ["bash", "-uc"]

[private]
default:
    just --list

# builds and starts the whole stack in docker
dev:
    docker compose --profile app up -d --build

# stops the stack, the data stays in the volumes
stop:
    docker compose --profile app down

# follows the logs, of one service if given (backend, worker, frontend, keycloak)
logs service="":
    docker compose --profile app logs -f {{service}}

# local test users and the backend's keycloak client, run again any time
seed:
    uv run --directory backend python -m scripts.seed_dev

# create a tag with the next version, auto generated by git cliff
[no-cd]
bump-version push="":
    #!/usr/bin/env bash
    export VERSION="$( git cliff --bumped-version )"
    git tag -m "$VERSION" "$VERSION"
    git log HEAD~1..HEAD

    if [[ "{{push}}" = "push" ]]; then
        git push origin $VERSION
    fi

# generate and aggregate a changelog from the last tag
[no-cd]
changelog:
    git cliff --latest > CHANGELOG.md
